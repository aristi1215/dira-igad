# syntax=docker/dockerfile:1
# One-shot image for migrate / bootstrap / demo seed on the host.
FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev gdal-bin build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY scripts ./scripts
COPY infra/alembic ./infra/alembic
COPY infra/alembic.ini ./infra/alembic.ini
COPY data ./data
COPY artifacts ./artifacts
ENV SEEDED_DATA_DIR=/app/data/seeded

RUN pip install --no-cache-dir \
    alembic \
    "./packages/dira_core" \
    "./packages/dira_features" \
    "./packages/dira_data" \
    "./packages/dira_ml" \
    "./packages/dira_llm" \
    "./packages/dira_dispatch" \
    "./apps/api" \
    "./apps/worker"

CMD ["bash", "-lc", "alembic -c infra/alembic.ini upgrade head && python -m scripts.bootstrap && python -m scripts.demo"]
