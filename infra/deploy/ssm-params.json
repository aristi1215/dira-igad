{
  "commands": [
    "aws s3 cp s3://dira-igad-deploy-af-330420073176/ssm-bootstrap.sh /tmp/ssm-bootstrap.sh --region af-south-1",
    "sed -i 's/\\r$//' /tmp/ssm-bootstrap.sh",
    "chmod +x /tmp/ssm-bootstrap.sh",
    "nohup bash /tmp/ssm-bootstrap.sh > /var/log/dira-ssm-launcher.log 2>&1 &",
    "echo PID=$!",
    "sleep 3",
    "tail -n 30 /var/log/dira-bootstrap.log || tail -n 30 /var/log/dira-ssm-launcher.log || true"
  ]
}
