# Dira environment — copy to .env and fill secrets. Never commit .env.

# live | seeded  — demo always runs seeded
DATA_MODE=seeded

# Host port 55432 avoids clashing with local Postgres on 5432–5434 (see infra/docker-compose.yml).
DATABASE_URL=postgresql://dira:dira@localhost:55432/dira

API_HOST=0.0.0.0
API_PORT=8000
# Live Twilio/TTS callbacks need a public HTTPS URL — ngrok: https://dashboard.ngrok.com/get-started/setup
PUBLIC_BASE_URL=http://localhost:8000

# LLM (optional in seeded mode — use canned adapters)
# OpenAI: https://platform.openai.com/api-keys
# Anthropic (fallback): https://console.anthropic.com/settings/keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ACLED (live mode only) — myACLED Research+ recommended
# Login: https://acleddata.com/user/login
# Docs: https://acleddata.com/api-documentation/getting-started
# OAuth: POST /oauth/token (grant_type=password, client_id=acled, scope=authenticated)
# then GET /api/acled/read with Authorization: Bearer <token>
# Research: event-level data excludes the past 12 months.
ACLED_EMAIL=
ACLED_PASSWORD=

# Information layer — live connectors (DATA_MODE=live only; all optional,
# each degrades to the seeded snapshot when unset or unreachable)
# HDX HAPI: base64("app:email") from
# https://hapi.humdata.org/docs#/Generate%20App%20Identifier
# Plaintext app:email is auto-encoded; optional HDX_APP_ENCODED overrides.
HDX_APP_IDENTIFIER=
# HDX_APP_ENCODED=
# Live CHIRPS uses public UCSB africa_dekad HTTPS (no AWS account). Optional cache:
# CHIRPS_CACHE_DIR=
# News: GDELT DOC 2.0 is the primary live source (key-free, always on in live mode).
# Optional ReliefWeb overlay (register appname):
# https://reliefweb.int/user/register?destination=/node/add/user-application
RELIEFWEB_APPNAME=
# Hazards: GDACS flood/drought alerts are key-free and always on in live mode.
# UNHCR population API needs no key: https://api.unhcr.org/

# Voice dispatch — Twilio (replaces Africa's Talking)
# DISPATCH_MODE=mock keeps the seeded demo network-free.
# DISPATCH_MODE=twilio places real outbound voice calls (Play audio + Gather DTMF ack).
# Console: https://console.twilio.com
# SID / Auth Token / API keys: https://console.twilio.com/us1/account/keys-credentials/api-keys
# Buy a number: https://console.twilio.com/us1/develop/phone-numbers/manage/search
# Verify caller ID: https://console.twilio.com/us1/develop/phone-numbers/manage/verified
# Public webhooks (ngrok): https://dashboard.ngrok.com/get-started/setup
DISPATCH_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional API Key auth (Console → Account → API keys & tokens). Prefer this over Auth Token in apps.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# E.164 caller ID Twilio will dial from, including leading + (must be a number you own or verified).
TWILIO_FROM_NUMBER=
# Optional: override Twilio API host (default https://api.twilio.com). Leave blank.
TWILIO_API_BASE_URL=

# TTS (live); seeded uses data/seeded/audio/
# ElevenLabs API key: https://elevenlabs.io/app/settings/api-keys
# Pricing: https://elevenlabs.io/pricing
# Voice library (set TTS_VOICE_ID): https://elevenlabs.io/app/voice-library
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=

# Embeddings: live uses OpenAI text-embedding-3-small at 1024 dims;
# seeded uses deterministic precomputed vectors.
EMBEDDING_MODEL=text-embedding-3-small

# Dispatch / situation hysteresis
ZOMBIE_TIMEOUT_MINUTES=10
DISPATCH_POLL_SECONDS=30
MAX_DISPATCH_ATTEMPTS=5
RESOLVE_AFTER_CYCLES_BELOW_THRESHOLD=3

# MockDispatcher simulated ack delay (seconds) in seeded mode
MOCK_ACK_DELAY_SECONDS=2
